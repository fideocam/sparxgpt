{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build add-in (Release)",
      "type": "process",
      "command": "dotnet",
      "args": [
        "build",
        "${workspaceFolder}/src/EaGpt.AddIn/EaGpt.AddIn.csproj",
        "-c",
        "Release"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": "$msCompile",
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      }
    },
    {
      "label": "build solution (Release)",
      "type": "process",
      "command": "dotnet",
      "args": [
        "build",
        "${workspaceFolder}/EaGpt.sln",
        "-c",
        "Release"
      ],
      "group": "build",
      "problemMatcher": "$msCompile"
    },
    {
      "label": "test",
      "type": "process",
      "command": "dotnet",
      "args": [
        "test",
        "${workspaceFolder}/tests/EaGpt.Core.Tests/EaGpt.Core.Tests.csproj"
      ],
      "group": "test",
      "problemMatcher": "$msCompile"
    }
  ]
}
