{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build add-in (Release)",
      "type": "process",
      "command": "dotnet",
      "args": [
        "build",
        "${workspaceFolder}/src/EaGpt.AddIn/EaGpt.AddIn.csproj",
        "-c",
        "Release"
      ],
      "windows": {
        "command": "powershell",
        "args": [
          "-NoProfile",
          "-ExecutionPolicy",
          "Bypass",
          "-File",
          "${workspaceFolder}/scripts/build.ps1"
        ]
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": "$msCompile",
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      }
    },
    {
      "label": "promote to stable",
      "type": "process",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/scripts/build.ps1",
        "-PromoteToStable"
      ],
      "problemMatcher": "$msCompile"
    },
    {
      "label": "build solution (Release)",
      "type": "process",
      "command": "dotnet",
      "args": [
        "build",
        "${workspaceFolder}/EaGpt.sln",
        "-c",
        "Release"
      ],
      "group": "build",
      "problemMatcher": "$msCompile"
    },
    {
      "label": "test",
      "type": "process",
      "command": "dotnet",
      "args": [
        "test",
        "${workspaceFolder}/tests/EaGpt.Core.Tests/EaGpt.Core.Tests.csproj"
      ],
      "group": "test",
      "problemMatcher": "$msCompile"
    }
  ]
}
