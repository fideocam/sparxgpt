<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>EaGpt.AddIn</RootNamespace>
    <AssemblyName>EaGpt.AddIn</AssemblyName>
    <PlatformTarget>x64</PlatformTarget>
    <ComVisible>true</ComVisible>
    <AssemblyTitle>EaGPT</AssemblyTitle>
    <Product>EaGPT</Product>
    <Description>ArchiGPT-style Ollama chat add-in for Sparx Enterprise Architect</Description>
    <Version>1.0.0</Version>
    <Deterministic>true</Deterministic>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\EaGpt.Core\EaGpt.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies.net48" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>
  <Target Name="StageShareRelease" AfterTargets="Build" Condition="'$(Configuration)' == 'Release'">
    <PropertyGroup>
      <ShareReleaseDir>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\..\release'))</ShareReleaseDir>
    </PropertyGroup>
    <MakeDir Directories="$(ShareReleaseDir)" />
    <ItemGroup>
      <_ShareBin Include="$(TargetDir)EaGpt.AddIn.dll" />
      <_ShareBin Include="$(TargetDir)EaGpt.Core.dll" />
      <_ShareScripts Include="$(MSBuildThisFileDirectory)..\..\scripts\share\Install.ps1" />
      <_ShareScripts Include="$(MSBuildThisFileDirectory)..\..\scripts\share\Uninstall.ps1" />
    </ItemGroup>
    <Copy SourceFiles="@(_ShareBin)" DestinationFolder="$(ShareReleaseDir)" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(_ShareScripts)" DestinationFolder="$(ShareReleaseDir)" SkipUnchangedFiles="true" />
  </Target>
</Project>
